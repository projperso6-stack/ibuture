 Cordless Cleaning\u0026quot;]]],[\u0026quot;p\u0026quot;,{\u0026quot;uuid\u0026quot;:\u0026quot;mbsu5gtvmmzjvnquwjp\u0026quot;,\u0026quot;jc\u0026quot;:\u0026quot;justify\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;},\u0026quot;Cordless Convenience: Seamless transitions between rooms without being tied to an outlet.\u0026quot;]]],[\u0026quot;p\u0026quot;,{\u0026quot;uuid\u0026quot;:\u0026quot;mbsu5gtv5yagg646zu\u0026quot;,\u0026quot;jc\u0026quot;:\u0026quot;justify\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;},\u0026quot;Unparalleled Power: Advanced 600W motor delivers exceptional 50kPa suction power, clean up hair, dirt, and dust allergens on hard floors, stairs, carpet and upholstery — all without being plugged in.\u0026quot;]]],[\u0026quot;h4\u0026quot;,{\u0026quot;uuid\u0026quot;:\u0026quot;mbsu5gtvv19g01rlrxg\u0026quot;,\u0026quot;jc\u0026quot;:\u0026quot;justify\u0026quot;,\u0026quot;spacing\u0026quot;:{\u0026quot;before\u0026quot;:16,\u0026quot;after\u0026quot;:8,\u0026quot;line\u0026quot;:0.8529411764705882}},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;bold\u0026quot;:true,\u0026quot;sz\u0026quot;:12,\u0026quot;szUnit\u0026quot;:\u0026quot;pt\u0026quot;,\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;},\u0026quot;Spend Less Time for More Cleaning\u0026quot;]]],[\u0026quot;p\u0026quot;,{\u0026quot;uuid\u0026quot;:\u0026quot;mbsu5gtw4h290fc9c0d\u0026quot;,\u0026quot;jc\u0026quot;:\u0026quot;justify\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;text\u0026quot;},[\u0026quot;span\u0026quot;,{\u0026quot;data-type\u0026quot;:\u0026quot;leaf\u0026quot;