tc\",{\"rowSpan\":1,\"colSpan\":1,\"uuid\":\"mmj4wjxpxu1jhozz9v\",\"vAlign\":\"top\"},[\"p\",{\"uuid\":\"mmj4wjxp5cztmr79w86\"},[\"span\",{\"data-type\":\"text\"},[\"span\",{\"data-type\":\"leaf\"},\"V0 Flame-Retardant + Explosion-Proof Interior\"]]]]],[\"tr\",{\"uuid\":\"mmj4wjxpm1fzqz3uwvn\"},[\"tc\",{\"rowSpan\":1,\"colSpan\":1,\"uuid\":\"mmj50enni970gh0q86i\",\"vAlign\":\"top\"},[\"p\",{\"uuid\":\"mmj50ennarj31m4jwww\"},[\"span\",{\"data-type\":\"text\"},[\"span\",{\"data-type\":\"leaf\"},\"LED Modes\"]]]],[\"tc\",{\"rowSpan\":1,\"colSpan\":1,\"uuid\":\"mmj4wjxpyboaplun18\",\"vAlign\":\"top\"},[\"p\",{\"uuid\":\"mmj4wjxp42g0ajjw3uc\"},[\"span\",{\"data-type\":\"text\"},[\"span\",{\"data-type\":\"leaf\"},\"5 Modes (Lightning, Orange, Strobe, SOS, Long-Range Lamp)\"]]]]]]]'\u003e\n\u003ctable\u003e\n\u003ccolgroup\u003e \u003ccol width=\"325\"\u003e \u003ccol width=\"325\"\u003e \u003c\/colgroup\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan data-type=\"text\"\u003eParameter\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp style=\"text-align: center;\"\u003e\u003cspan data-type=\"text\"\u003eSpecification\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp style=\"text-align: left;\"\u003e\u003cspan data-type=\"text\"\u003ePeak Current\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e8000 A\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eBattery Capacity\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e268000 mAh\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eAir Compressor\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e160 PSI\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eVoltage\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e12 Volts\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eVehicle Compatibility\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eAll Gas \u0026amp; 12.0 L Diesel Engines\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eDimensions\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e8.7\"D x 2.13\"W x 5.59\"H\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eBattery Cell Composition\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eLithium Polymer\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eHousing\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eV0 Flame-Retardant + Explosion-Proof Interior\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003eLED Modes\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003ctd colspan=\"1\" rowspan=\"1\"\u003e\n\u003cp\u003e\u003cspan data-type=\"text\"\u003e5 Modes (Lightning, Orange, Strobe, SOS, Long-Range Lamp)\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003c\/tbody\u003e\n\u003c\/table\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003cp\u003e \u003c\/p\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e\n\u003c\/article\u003e","brand":"Buture Official","offers":[{"title":"Default Title","offer_id":48040556986623,"sku":"Beta09","price":109.99,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0621\/7462\/6047\/files\/buture-beta09-car-jump-starter-pp1.jpg?v=1773314507"}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0621\/7462\/6047\/collections\/1_67156c98-92de-4a83-8dbe-a2066f225f1a-533139.jpg?v=1732011175","url":"https:\/\/ibuture.com\/collections\/car-jump-starter.oembed","provider":"Buture Official","version":"1.0","type":"link"}