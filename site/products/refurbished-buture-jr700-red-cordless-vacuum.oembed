 height: 19.5938px;\"\u003eHair Cleaning Tool\u003c\/td\u003e\n\u003ctd style=\"width: 46.875%; height: 19.5938px;\"\u003e✓\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr style=\"height: 19.5938px; text-align: left;\"\u003e\n\u003ctd style=\"width: 46.875%; height: 19.5938px;\"\u003eBattery Pack\u003c\/td\u003e\n\u003ctd style=\"width: 46.875%; height: 19.5938px;\"\u003ex1\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003ctr style=\"height: 19.5938px;\"\u003e\n\u003ctd style=\"width: 46.875%; height: 19.5938px; text-align: left;\"\u003eHEPA Filter\u003cbr\u003e\n\u003c\/td\u003e\n\u003ctd style=\"width: 46.875%; height: 19.5938px; text-align: left;\"\u003ex3\u003c\/td\u003e\n\u003c\/tr\u003e\n\u003c\/tbody\u003e\n\u003c\/table\u003e","brand":"Buture Official","offers":[{"title":"95% Like-new","offer_id":48895068406015,"sku":"JR700RFXJ-1","price":89.0,"currency_code":"USD","in_stock":true},{"title":"99% Like-new","offer_id":48895068438783,"sku":"JR700RFXJ-2","price":99.0,"currency_code":"USD","in_stock":true}],"thumbnail_url":"\/\/cdn.shopify.com\/s\/files\/1\/0621\/7462\/6047\/files\/Buture_JR700_Red_Vacuum_Cleaner.jpg?v=1745921504","url":"https:\/\/ibuture.com\/products\/refurbished-buture-jr700-red-cordless-vacuum","provider":"Buture Official","version":"1.0","type":"link"}